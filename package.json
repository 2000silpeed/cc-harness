{
  "name": "cc-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint --no-error-on-unmatched-pattern --no-warn-ignored \"**/*.{js,mjs,html}\"",
    "format:check": "prettier . --check --ignore-unknown",
    "format": "prettier . --write --ignore-unknown",
    "design:check": "node scripts/check-design-system.mjs",
    "harness:check": "node scripts/check-harness.mjs",
    "check": "npm run lint && npm run design:check && npm run harness:check && npm run format:check",
    "lint-staged": "lint-staged",
    "lint:commit": "commitlint --edit"
  },
  "lint-staged": {
    "*.{js,mjs,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yaml,yml}": "prettier --write"
  },
  "prettier": {
    "endOfLine": "lf",
    "printWidth": 100,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "all",
    "useTabs": false
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-html": "8.2.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6"
  }
}
