{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/check-design-system.mjs\" --hook",
            "timeout": 10,
            "statusMessage": "디자인 기준 검사"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/check-pm-design.mjs\" --hook",
            "timeout": 10,
            "statusMessage": "PM 디자인 기준 검사"
          }
        ]
      }
    ]
  }
}
